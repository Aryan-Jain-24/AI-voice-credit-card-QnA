# Copy this file to .env and fill in your keys. Never commit the real .env.
# Used by graph.py's planner/verbalizer (gpt-4o-mini) -- unchanged by S10.
OPENAI_API_KEY=sk-...
# Used by voice.py's STT (Deepgram Nova-3) and TTS (Deepgram Aura-2) -- S10.
DEEPGRAM_API_KEY=dg-...
# LangSmith tracing + eval-run logging -- S12. Optional: leave LANGSMITH_TRACING
# unset/false to run with tracing off (the graph, voice.py, and eval.py all
# degrade to "tracing silently stops", never to a broken pipeline -- see
# .claude/agents/langsmith-observability.md).
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=ls-...
LANGSMITH_PROJECT=credit-card-voice-chatbot
